          }
        }
      }
    },
    "%lld records were created from it. They're kept, but lose their source link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daraus wurden %lld Einträge erstellt. Sie bleiben erhalten, verlieren aber den Verweis auf die Quelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fiches ont été créées à partir de ce document. Elles sont conservées, mais perdent le lien vers leur source."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類から%lld件の記録が作成されています。記録は残りますが、元の書類へのリンクは外れます。"
          }
        }
