    "%lld fields are marked Check — compare them with the original.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Felder sind mit „Prüfen“ markiert – vergleiche sie mit dem Original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld champs sont marqués « À vérifier » – comparez-les à l’original."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld項目に「要確認」の印があります。原本と見比べてください。"
          }
        }
      }
    },
    "%lld mo": {
